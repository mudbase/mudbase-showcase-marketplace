# Mudbase project this app talks to — see plan/build-plan.md for the full collection schema.
# All three vars are safe to expose client-side: the base URL and project ID are public routing
# information, and the API key is a publishable (`pk_`) key, not a secret.
NEXT_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
NEXT_PUBLIC_MUDBASE_PROJECT_ID=6a6d3faad07caabbbdfc56a6
NEXT_PUBLIC_MUDBASE_API_KEY=pk_7d6f88a8d8537bdf00c8cc4a2ebf79ee

# Collection IDs (create once in the Mudbase dashboard, then paste the IDs here)
NEXT_PUBLIC_LISTINGS_COLLECTION_ID=6a6d3fced07caabbbdfc586b
NEXT_PUBLIC_PROPOSALS_COLLECTION_ID=6a6d3fcfd07caabbbdfc5896
NEXT_PUBLIC_MESSAGES_COLLECTION_ID=6a6d3fd0d07caabbbdfc58c5
