@page "/Listings/Mine"
@model MudbaseShowcase.Marketplace.Pages.Listings.MineModel
@{
    ViewData["Title"] = "My listings";
}

@if (Model.IsForbidden)
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">Sign in with a client account to view your listings.</p>
        <a class="btn btn-brand btn-sm" asp-page="/Login">Sign in</a>
    </div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-semibold mb-0">My listings</h1>
    <a class="btn btn-brand btn-sm" asp-page="/Listings/New">Post a listing</a>
</div>

@if (Model.LoadError is not null)
{
    <p class="text-danger small">@Model.LoadError</p>
}

@if (Model.LoadError is null && Model.Listings.Count == 0)
{
    <p class="text-muted small">You haven&rsquo;t posted any listings yet.</p>
}

<div class="d-flex flex-column gap-3">
    @foreach (ListingDocument listing in Model.Listings)
    {
        int count = Model.ProposalCounts.GetValueOrDefault(listing.Id);
        <a href="/Listings/@listing.Id" class="text-decoration-none text-reset">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">@listing.Title</div>
                        <div class="small text-muted">@DisplayHelpers.FormatCurrency(listing.Budget) · @count proposal@(count == 1 ? "" : "s") · @DisplayHelpers.FormatRelativeTime(listing.CreatedAt)</div>
                    </div>
                    <span class="badge text-bg-light border">@ListingStatus.Label(listing.Status)</span>
                </div>
            </div>
        </a>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Listings pagination">
        <ul class="pagination">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-page="/Listings/Mine" asp-route-Page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
