@page "/Proposals"
@model MudbaseShowcase.Marketplace.Pages.ProposalsModel
@{
    ViewData["Title"] = "My proposals";
}

@if (Model.IsForbidden)
{
    <div class="text-center py-5">
        <p class="text-muted mb-3">Sign in with a freelancer account to view your proposals.</p>
        <a class="btn btn-brand btn-sm" asp-page="/Login">Sign in</a>
    </div>
    return;
}

<div class="mb-4">
    <h1 class="h3 fw-semibold">My proposals</h1>
    <p class="text-muted">Every proposal you&rsquo;ve submitted, across all listings.</p>
</div>

@if (Model.LoadError is not null)
{
    <p class="text-danger small">@Model.LoadError</p>
}

@if (Model.LoadError is null && Model.Proposals.Count == 0)
{
    <p class="text-muted small">You haven&rsquo;t submitted any proposals yet. <a asp-page="/Index">Browse listings</a>.</p>
}

<div class="d-flex flex-column gap-3">
    @foreach (ProposalDocument proposal in Model.Proposals)
    {
        ListingDocument? listing = Model.ListingsById.GetValueOrDefault(proposal.ListingId);
        <a href="/Listings/@proposal.ListingId" class="text-decoration-none text-reset">
            <div class="card">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">@(listing?.Title ?? "Listing")</div>
                        <div class="small text-muted">Your rate: @DisplayHelpers.FormatCurrency(proposal.ProposedRate) · @DisplayHelpers.FormatRelativeTime(proposal.CreatedAt)</div>
                    </div>
                    <span class="badge text-bg-@(proposal.Status == ProposalStatus.Accepted ? "success" : proposal.Status == ProposalStatus.Rejected ? "danger" : "secondary")">@ProposalStatus.Label(proposal.Status)</span>
                </div>
            </div>
        </a>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Proposals pagination">
        <ul class="pagination">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-page="/Proposals" asp-route-Page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
