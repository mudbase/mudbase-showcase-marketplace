@using MudbaseShowcase.Marketplace.Services
@inject MudbaseSessionAccessor SessionAccessor
@{
    MudbaseSessionUser? currentUser = SessionAccessor.CurrentUser;
    bool isSignedIn = currentUser is { IsSignedIn: true };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? $"{t} · Mudbase Marketplace" : "Mudbase Marketplace")</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-page="/Index">Mudbase Marketplace</a>
            <div class="d-flex align-items-center gap-2 ms-auto">
                @if (isSignedIn && currentUser!.IsClient)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Listings/Mine">My listings</a>
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Listings/New">Post a listing</a>
                }
                @if (isSignedIn && currentUser!.IsFreelancer)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Proposals">My proposals</a>
                }
                @if (isSignedIn)
                {
                    <span class="badge text-bg-secondary">@currentUser!.DisplayName &middot; @Rbac.RoleLabel(currentUser.CustomRole)</span>
                    <form method="post" asp-page="/Logout" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-brand btn-sm" asp-page="/Login">Sign in</a>
                }
            </div>
        </div>
    </header>

    <main class="container-fluid px-4 py-4">
        @RenderBody()
    </main>

    <footer class="container-fluid px-4 py-5 text-muted small border-top mt-5">
        Every listing, proposal, and message on this page is served by a real Mudbase project via the
        real Mudbase C# SDK - no custom backend. This is one of several per-language reimplementations of
        the same reference freelance marketplace.
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
