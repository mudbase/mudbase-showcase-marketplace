<div style="max-width:36rem;">
  <h1 class="page-title"><%= h(@form_title) %></h1>

  <form action="<%= h(@form_action) %>" method="post" class="stack" novalidate>
    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" maxlength="120" value="<%= h(@listing[:title]) %>" placeholder="e.g. Build a marketing landing page" required>
    </div>
    <div class="field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="6" maxlength="4000" placeholder="Describe the scope, deliverables, and timeline…" required><%= h(@listing[:description]) %></textarea>
      <span class="field-hint">At least 20 characters.</span>
    </div>
    <div class="field-row">
      <div class="field">
        <label for="budget">Budget (USD)</label>
        <input type="number" id="budget" name="budget" min="1" step="1" value="<%= h(@listing[:budget]) %>" required>
      </div>
      <div class="field">
        <label for="category">Category (optional)</label>
        <input type="text" id="category" name="category" maxlength="60" value="<%= h(@listing[:category]) %>" placeholder="e.g. Web Development">
      </div>
    </div>

    <% if @show_status %>
      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
          <% %w[open in_progress completed].each do |status| %>
            <option value="<%= status %>" <%= "selected" if @listing_status == status %>><%= listing_status_label(status) %></option>
          <% end %>
        </select>
      </div>
    <% end %>

    <div style="display:flex; gap:0.75rem;">
      <button type="submit" class="btn"><%= h(@submit_label) %></button>
      <a href="/listings/mine" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>
