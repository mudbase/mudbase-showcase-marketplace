# ── Mudbase project (public — a project/collection ID is not a secret) ─────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
LISTINGS_COLLECTION_ID=
PROPOSALS_COLLECTION_ID=
MESSAGES_COLLECTION_ID=
# The collection's slug (distinct from its _id above) - the search endpoint's `collections`
# param matches on slug, not on the collection's ObjectId.
LISTINGS_COLLECTION_SLUG=listings

# ── Session ──────────────────────────────────────────────────────────────
# Rack::Session::Cookie holds every Mudbase-issued JWT (real user + silent guest) server-side,
# inside an httponly, signed+encrypted cookie - client JS never touches it. Generate a long
# random value, e.g.: ruby -rsecurerandom -e "puts SecureRandom.hex(32)"
SESSION_SECRET=

# ── Server ───────────────────────────────────────────────────────────────
PORT=4567
RACK_ENV=development
