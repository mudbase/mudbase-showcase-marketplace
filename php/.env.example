# ── Mudbase project (all required — see README "Setup") ────────────────────
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=
MUDBASE_LISTINGS_COLLECTION_ID=
MUDBASE_PROPOSALS_COLLECTION_ID=
MUDBASE_MESSAGES_COLLECTION_ID=

# The listings collection's slug (distinct from its _id above) — the dedicated search endpoint's
# `collections` query param matches on slug, not on the collection's _id. See
# plan/build-plan.md "Search".
MUDBASE_LISTINGS_COLLECTION_SLUG=listings

# ── Session ──────────────────────────────────────────────────────────────────
# Name of the native PHP session cookie. Change only if it collides with another
# app on the same host/port during local development.
SESSION_NAME=mudbase_showcase_marketplace_php
