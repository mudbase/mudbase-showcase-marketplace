# ── Mudbase project (see plan/build-plan.md for the full collection/permission schema) ──
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=6a6d3faad07caabbbdfc56a6
MUDBASE_LISTINGS_COLLECTION_ID=6a6d3fced07caabbbdfc586b
MUDBASE_PROPOSALS_COLLECTION_ID=6a6d3fcfd07caabbbdfc5896
MUDBASE_MESSAGES_COLLECTION_ID=6a6d3fd0d07caabbbdfc58c5

# Slug (not _id) of the listings collection - the dedicated search endpoint's `collections` query
# param matches on slug, not the collection's Mudbase document id. See internal/mbase/search.go.
MUDBASE_LISTINGS_COLLECTION_SLUG=listings

# ── App/session config ───────────────────────────────────────────────────────
# Signs and encrypts the httpOnly session cookie holding the Mudbase JWT. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Set to "true" once this app is served over HTTPS in production - a Secure cookie is silently
# never sent over plain HTTP, which would break every page on local development.
COOKIE_SECURE=false

# Local HTTP listen port.
PORT=8080
