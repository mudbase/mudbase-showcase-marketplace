# ── Mudbase project ──────────────────────────────────────────────────────
# Same provisioned Mudbase project as the reference ../web app in this repo —
# see ../web/plan/build-plan.md for the collection/permission schema (local
# auth, Multi-Role with client/freelancer, three collections below, each
# granted per the RBAC matrix — read to both roles, write per role).
MUDBASE_URL=https://cloud.mudbase.dev
MUDBASE_PROJECT_ID=6a6d3faad07caabbbdfc56a6
LISTINGS_COLLECTION_ID=6a6d3fced07caabbbdfc586b
PROPOSALS_COLLECTION_ID=6a6d3fcfd07caabbbdfc5896
MESSAGES_COLLECTION_ID=6a6d3fd0d07caabbbdfc58c5
# The listings collection's slug, distinct from its _id above - the search endpoint's
# `collections` query param matches on slug (see app/mudbase_client.py::search_sync).
LISTINGS_COLLECTION_SLUG=listings

# ── Session cookie (server-only — never expose to the browser as JS) ───────
# Signs the itsdangerous/Starlette session cookie that holds the Mudbase JWT,
# refresh token, and user profile server-side. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=mudbase_showcase_marketplace_session
# Set to "true" behind HTTPS in production so the session cookie is Secure.
SESSION_HTTPS_ONLY=false

# ── Demo accounts (quick sign-in on /login) ─────────────────────────────────
# The two already-verified client/freelancer accounts documented in
# plan/build-plan.md. Not a production secret — this whole app is a public
# showcase and these credentials are already published in this project's own
# README/build-plan. Override for a private deployment.
DEMO_CLIENT_EMAIL=market.client.demo@gmail.com
DEMO_FREELANCER_EMAIL=market.freelancer.demo@gmail.com
DEMO_PASSWORD=DemoTest123!
