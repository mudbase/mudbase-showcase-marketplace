# ── Mudbase project (public — a project/collection ID is not a secret) ─────
# Every value below is read client-side via EXPO_PUBLIC_* (Expo's convention for env vars
# that are safe to bundle into the app binary). Every request this app makes authenticates
# with a JWT — a real signed-in account's for writes, an anonymous guest session's for public
# reads (see plan/build-plan.md "Auth flow") — never a static credential, so nothing needs to
# live outside EXPO_PUBLIC_*.
EXPO_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev
EXPO_PUBLIC_MUDBASE_PROJECT_ID=
EXPO_PUBLIC_LISTINGS_COLLECTION_ID=
EXPO_PUBLIC_PROPOSALS_COLLECTION_ID=
EXPO_PUBLIC_MESSAGES_COLLECTION_ID=
